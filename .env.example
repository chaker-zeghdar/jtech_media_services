# Copy to `.env.local` and fill in. `.env.local` is gitignored.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Absolute origin used for canonical and hreflang tags.
#
# Only needed for local production-like builds and for non-Vercel hosting. On
# Vercel, VERCEL_PROJECT_PRODUCTION_URL is provided automatically and is used as
# the fallback, so this can be left unset there.
NEXT_PUBLIC_SITE_URL=https://jtech-dz.com

# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------
# Safe in the browser; RLS is what actually gates access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely — never prefix this NEXT_PUBLIC_, never
# import it into a client component. Used by one-off maintenance scripts.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Cloudflare R2 — product photo storage
# ---------------------------------------------------------------------------
# The public bucket URL (bucket → Settings → Public Access). This one is read
# at build time by next.config.ts's images.remotePatterns, so its hostname must
# match the entry there.
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# Credentials for the admin upload route (app/api/admin/uploads). Server-side
# only — the browser receives a short-lived presigned URL, never these. Needed
# in Vercel Production AND Preview, unlike the maintenance scripts.
# Generate under R2 → Manage API tokens (Object Read & Write on this bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=jtech-product-images
